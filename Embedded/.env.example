# Локальная конфигурация сборки и загрузки.
# Скопируйте файл в .env и укажите значения для своего окружения.

# Параметры сборки.
SYSTEM=windows
PROGRAM_NAME=YourActualProgramName
BUILD_DIR=build
MAKE_COMMAND=make
GCC_PLACE=/path/to/arm-none-eabi-toolchain

# Параметры загрузки через OpenOCD.
OPENOCD_EXE=/path/to/openocd
OPENOCD_SCRIPTS_DIR=/path/to/openocd/scripts
OPENOCD_CONFIG=/path/to/openocd/board.cfg
