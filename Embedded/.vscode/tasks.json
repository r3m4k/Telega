{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Полная пересборка проекта",
            "type": "shell",
            "command": "bash",
            "args": [
                "./scripts/build.sh",
                "rebuild_all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Пересборка файлов пользователя и линковка проекта",
            "type": "shell",
            "command": "bash",
            "args": [
                "./scripts/build.sh",
                "rebuild_user"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Сборка файлов пользователя и линковка проекта",
            "type": "shell",
            "command": "bash",
            "args": [
                "./scripts/build.sh",
                "build_user"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Загрузить программу через OpenOCD",
            "type": "shell",
            "command": "bash",
            "args": [
                "./scripts/flash.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
