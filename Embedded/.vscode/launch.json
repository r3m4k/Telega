{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cortex-debug",
            "name": "OpenOCD",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/${config:myProject.Debug_Win_dir}/${config:myProject.project_name}.elf",
            "servertype": "openocd",
            "serverpath": "${config:cortex-debug.openocdPath}",
            "gdbPath": "${config:cortex-debug.gdbPath.windows}",
            "request": "launch",
            "configFiles": [
                "board/stm32f3discovery.cfg"
            ],
            "searchDir": [
                "${config:embeddedDebug.openocdScriptsDir}"
            ],
            "svdFile":"${workspaceFolder}/STM32F303.svd",
            "preLaunchTask": "Пересборка файлов пользователя и линковка проекта"
        }
    ]
}
